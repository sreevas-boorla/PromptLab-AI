# PromptLab AI Environment Variables

# Backend Server Configuration
PROMPTLAB_DB_PATH=promptlab.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROMPTLAB_ENV=development
